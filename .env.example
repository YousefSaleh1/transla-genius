# TranslaGenius environment variables. Copy what you need into your app's .env.
# Only the active provider's key is required; everything else has a default.
# Uncomment only what you set: an empty value (VAR=) is not the same as unset.

# Which provider entry performs translations:
# openrouter (default), openai, gemini, deepseek, mistral, custom, fallback
TRANSLATION_PROVIDER=openrouter

# Language content is authored in. Empty = the locale of the request that saves the
# record (captured at dispatch, never the queue worker's). Set it to always translate
# from one language. Backfill: --source, then this, then app.locale.
# TRANSLATION_SOURCE_LOCALE=

# Shared by every preset
# TRANSLATION_API_TIMEOUT=10
# Sent only when set (openrouter alone defaults to 0.3). Empty = not sent.
# TRANSLATION_TEMPERATURE=
# Unset by default (provider's own limit). A truncated reply fails the translation.
# TRANSLATION_MAX_TOKENS=

# System prompt for OpenAI-compatible presets; empty = built-in prompt.
# Placeholders: {source_locale} {target_locale} {field} {model}
# TRANSLATION_SYSTEM_PROMPT=

# Batching: all missing languages of a field in one request (JSON reply). Off by default.
# TRANSLATION_BATCH=false
# Batch prompt; empty = built-in. Placeholders: {source_locale} {target_locales} {field} {model}
# TRANSLATION_BATCH_PROMPT=

# Translation cache: identical text + setup is requested once (README "Translation Cache").
# Cached values are translated field content in that store.
# TRANSLATION_CACHE=false
# TRANSLATION_CACHE_STORE=
# Seconds; 0 = forever. Default 30 days.
# TRANSLATION_CACHE_TTL=2592000

# Review workflow: translations wait for approval before they're published.
# Publish the migrations first. Scope models/fields in the published config.
# TRANSLATION_REVIEW=false
# Only these target languages are reviewed (comma-separated); empty = all
# TRANSLATION_REVIEW_LOCALES=
# While a re-translation is pending: keep (show the stale text) or clear (show the fallback)
# TRANSLATION_REVIEW_WHILE_PENDING=keep
# After a rejection: leave (missing until retranslate()) or retranslate
# TRANSLATION_REVIEW_ON_REJECT=leave

# Queue for translation jobs; empty = the app's default connection / queue
# TRANSLATION_QUEUE_CONNECTION=
# TRANSLATION_QUEUE=
# Hold jobs until the surrounding DB transaction commits (dropped on rollback)
# TRANSLATION_DISPATCH_AFTER_COMMIT=true

# Retries (see README "Retries and Rate Limits"). Worst case per field/locale:
# (TRANSLATION_HTTP_RETRIES + 1) x TRANSLATION_JOB_TRIES requests.
# TRANSLATION_HTTP_RETRIES=1
# TRANSLATION_HTTP_RETRY_AFTER_MAX=10
# TRANSLATION_FALLBACK_HTTP_RETRIES=0
# TRANSLATION_JOB_TRIES=3
# TRANSLATION_JOB_BACKOFF=10,30

# Failover (used when TRANSLATION_PROVIDER=fallback): comma-separated, tried in order
# TRANSLATION_FALLBACK_CHAIN=

# --- openrouter -------------------------------------------------------------
# Falls back to TRANSLATION_API_KEY / TRANSLATION_API_URL / TRANSLATION_MODEL when unset.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# Optional attribution headers (HTTP-Referer / X-OpenRouter-Title)
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=
# reasoning_effort; empty = not sent
# OPENROUTER_REASONING_EFFORT=
# Batch override for this preset (true/false); empty = TRANSLATION_BATCH
# OPENROUTER_BATCH=
# OPENROUTER_COST_PER_1K_PROMPT_TOKENS=
# OPENROUTER_COST_PER_1K_COMPLETION_TOKENS=

# --- openai -----------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions
# reasoning_effort; empty = not sent (default: none)
# OPENAI_REASONING_EFFORT=none
# Batch override for this preset (true/false); empty = TRANSLATION_BATCH
# OPENAI_BATCH=
# OPENAI_COST_PER_1K_PROMPT_TOKENS=
# OPENAI_COST_PER_1K_COMPLETION_TOKENS=

# --- gemini (OpenAI-compatible endpoint) ------------------------------------
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# reasoning_effort; empty = not sent
# GEMINI_REASONING_EFFORT=
# Batch override for this preset (true/false); empty = TRANSLATION_BATCH
# GEMINI_BATCH=
# GEMINI_COST_PER_1K_PROMPT_TOKENS=
# GEMINI_COST_PER_1K_COMPLETION_TOKENS=

# --- deepseek ---------------------------------------------------------------
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# reasoning_effort; empty = not sent (default: none)
# DEEPSEEK_REASONING_EFFORT=none
# Batch override for this preset (true/false); empty = TRANSLATION_BATCH
# DEEPSEEK_BATCH=
# DEEPSEEK_COST_PER_1K_PROMPT_TOKENS=
# DEEPSEEK_COST_PER_1K_COMPLETION_TOKENS=

# --- mistral ----------------------------------------------------------------
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
# reasoning_effort; empty = not sent
# MISTRAL_REASONING_EFFORT=
# Batch override for this preset (true/false); empty = TRANSLATION_BATCH
# MISTRAL_BATCH=
# MISTRAL_COST_PER_1K_PROMPT_TOKENS=
# MISTRAL_COST_PER_1K_COMPLETION_TOKENS=

# --- custom: any other OpenAI-compatible endpoint (Ollama, vLLM, LiteLLM, ...)
# Also the legacy variables the openrouter preset falls back to.
# TRANSLATION_API_URL=
# TRANSLATION_API_KEY=
# TRANSLATION_MODEL=
# Header the key is sent in: Authorization (sends "Bearer <key>") or e.g. api-key
# TRANSLATION_AUTH_HEADER=Authorization
# max_tokens, or max_completion_tokens for APIs that deprecate max_tokens
# TRANSLATION_TOKEN_LIMIT_PARAM=max_tokens
# reasoning_effort; empty = not sent
# TRANSLATION_REASONING_EFFORT=
# Batch override for custom (true/false); empty = TRANSLATION_BATCH
# TRANSLATION_CUSTOM_BATCH=
# JSON mode for custom batch replies: json_schema, json_object, or empty (prompt only)
# TRANSLATION_BATCH_RESPONSE_FORMAT=
# TRANSLATION_COST_PER_1K_PROMPT_TOKENS=
# TRANSLATION_COST_PER_1K_COMPLETION_TOKENS=

# --- usage & cost tracking (publish and run the migration first) -------------
# TRANSLATION_USAGE_TRACKING_ENABLED=false
